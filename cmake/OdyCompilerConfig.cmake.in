@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@ODYCOMPILER_USE_SYSTEM_DEPS@)
    find_dependency(spdlog REQUIRED)
    find_dependency(nlohmann_json REQUIRED)
    find_package(CLI11 REQUIRED)
    find_package(Boost REQUIRED COMPONENTS filesystem)
    message(STATUS "OdyCompiler requires system spdlog, nlohmann_json, CLI11, boost and odyplan")
else()
    message(WARNING "OdyCompiler was built with FetchContent!")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/OdyCompilerTargets.cmake")

check_required_components(OdyCompiler)